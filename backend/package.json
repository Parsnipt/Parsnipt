{
  "name": "parsnipt-backend",
  "version": "0.1.0",
  "description": "Express.js REST API for Parsnipt code extraction platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run"
  },
  "keywords": [
    "code-extraction",
    "ast-parsing",
    "javascript",
    "typescript",
    "babel"
  ],
  "author": "Parsnipt Contributors",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.1.6",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2",
    "redis": "^4.6.10",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "@babel/parser": "^7.22.20",
    "@babel/types": "^7.22.19",
    "@babel/traverse": "^7.22.20",
    "@babel/generator": "^7.22.20",
    "knex": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/jest": "^29.5.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/cors": "^2.8.13",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "prettier": "^3.0.2",
    "tsx": "^3.14.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}