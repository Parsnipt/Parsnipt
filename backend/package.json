{
  "name": "parsnipt-backend",
  "version": "0.1.0",
  "description": "Express.js REST API for Parsnipt code extraction platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:extraction": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/services/extraction/__tests__",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:migrate": "knex migrate:latest",
    "db:migrate:phase1.5": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest --specific 004_migrate_to_new_schema.ts",    
    "db:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "migrate:extractions": "tsx scripts/migrate-extractions.ts",
    "phase1.5:setup": "npm run db:migrate:phase1.5 && npm run migrate:extractions && npm run test:extraction"
  },
  "keywords": [
    "code-extraction",
    "ast-parsing",
    "javascript",
    "typescript",
    "babel"
  ],
  "author": "Parsnipt Contributors",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^2.5.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "redis": "^4.6.10",
    "resend": "^6.25.0",
    "typescript": "^5.1.6",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.5.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
